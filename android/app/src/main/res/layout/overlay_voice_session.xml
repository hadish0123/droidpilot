<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primeVoiceOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2070A12"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnOverlayClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/voice_icon_bg"
            android:contentDescription="Close PRIME Voice"
            android:padding="12dp"
            android:src="@drawable/ic_close_prime"
            android:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIME Voice"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Persistent voice • P6"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOverlayMinimize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="−"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:contentDescription="کوچک یا بزرگ کردن پنجرهٔ صدا"
            android:background="@drawable/voice_icon_bg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voiceOverlayBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/p6_badge"
            android:paddingStart="34dp"
            android:paddingTop="12dp"
            android:paddingEnd="34dp"
            android:paddingBottom="12dp"
            android:text="P6"
            android:textColor="@color/on_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayVoiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="آماده‌سازی صدای فارسی…"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/chat_bg"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvOverlayReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="سلام، من PRIME هستم. دستور یا پرسشت را بگو."
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.25"
                android:textDirection="firstStrong"
                android:textIsSelectable="true" />
        </ScrollView>

        <TextView
            android:id="@+id/tvOverlayVoiceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="برای قطع صدا و گفتن دستور بعدی، میکروفن را بزن. با دکمهٔ − پنجره را کوچک کن."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/composer_bg"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etOverlayVoiceMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="دستور بعدی را بنویس یا بگو…"
            android:textDirection="firstStrong"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="50dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnOverlayMic"
            android:layout_width="48dp"
            android:layout_height="50dp"
            android:background="@drawable/voice_icon_bg"
            android:contentDescription="Speak to PRIME"
            android:padding="12dp"
            android:src="@drawable/ic_mic_prime"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnOverlaySend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/voice_send_bg"
            android:contentDescription="Send command"
            android:padding="12dp"
            android:src="@drawable/ic_send_prime"
            android:tint="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
