{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime.local/schemas/prime-plugin.v1.json",
  "title": "PRIME Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "runtime",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "prime.plugin.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "const": "mcp"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "tools",
          "resources",
          "prompts"
        ]
      }
    }
  }
}
